{
  "$schema": "https://app.kilo.ai/config.json",

  // Default models — architect/reviewer use v4-pro (reasoning), worker uses v4-flash (fast)
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",

  // Persistent instructions loaded every session. AGENTS.md is auto-loaded by Kilo — only rules need explicit paths.
  "instructions": [
    ".kilo/rules/00-conventions.md",
    ".kilo/rules/10-workflow.md"
  ],

  // Use V4 Flash for context compaction summaries — saves ~92% per compaction vs V4 Pro
  "agent": {
    "compaction": {
      "model": "deepseek/deepseek-v4-flash"
    },
    // Use V4 Flash for the explore subagent — codebase exploration is pattern matching, not reasoning
    "explore": {
      "model": "deepseek/deepseek-v4-flash"
    }
  },

  // Permissions — bash is allowed for running lint, tests, and build commands
  "permission": {
    "bash": "allow"
  },

  // Git snapshots before each agent action for easy rollback
  "snapshot": true
}
